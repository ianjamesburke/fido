# -----------------------------------------------------------------------------
# TUI Client Configuration
# -----------------------------------------------------------------------------
# Server URL for the TUI client to connect to
# For local development: http://localhost:3000
# For production: https://fido-web-production.up.railway.app
FIDO_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# GitHub OAuth credentials (for Device Flow authentication)
# Register an OAuth app at: https://github.com/settings/developers
# Note: Device Flow doesn't require a callback URL.
# REQUIRED: Set these environment variables before starting the server.
GITHUB_CLIENT_ID=your_github_client_id_here
# Optional for best-effort token revocation on logout.
GITHUB_CLIENT_SECRET=
# Base64-encoded 32-byte key used to encrypt stored GitHub OAuth tokens at rest.
FIDO_TOKEN_KEY=replace_with_base64_encoded_32_byte_key

# Skip sqlx compile-time verification (use offline mode)
SQLX_OFFLINE=true
